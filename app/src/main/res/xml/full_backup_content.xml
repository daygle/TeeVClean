<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup rules for Android 11 (API 30) and lower.
  Backups are off (android:allowBackup="false"), so exclude everything;
  nothing is allowed to leave the device.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="."/>
    <exclude domain="database" path="."/>
    <exclude domain="external" path="."/>
    <exclude domain="root" path="."/>
</full-backup-content>
