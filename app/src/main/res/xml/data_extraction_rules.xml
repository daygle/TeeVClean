<?xml version="1.0" encoding="utf-8"?>
<!--
  Data extraction rules for Android 12 (API 31) and higher.
  Backups are off (android:allowBackup="false"), so only transfer/backup
  exclusions are needed here; nothing is allowed to leave the device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="files" path="."/>
        <exclude domain="external" path="."/>
        <exclude domain="root" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude-domain name="sharedpref"/>
        <exclude-domain name="database"/>
        <exclude-domain name="files"/>
        <exclude-domain name="external"/>
        <exclude-domain name="root"/>
    </device-transfer>
</data-extraction-rules>
